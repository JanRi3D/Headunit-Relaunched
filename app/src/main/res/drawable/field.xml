<?xml version="1.0" encoding="utf-8"?>
<!--
  The IP box. Focus is drawn as an accent outline rather than the Holo underline,
  because on a resistive panel you often cannot see a 1px line under your own
  thumb and need to know the keyboard is going somewhere.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
